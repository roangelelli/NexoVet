# Copiar este archivo como ".env" y completar los valores reales.
# El archivo ".env" NO se sube al repositorio.

PORT=3000

# Base de datos (Aiven -> servicio MySQL -> Overview)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb

# Certificado CA de Aiven (SSL). Usar UNA de las dos opciones:
# 1) Ruta al archivo ca.pem (desarrollo local)
DB_SSL_CA_PATH=
# 2) Contenido del certificado en una variable (para Render, donde no hay archivo)
DB_SSL_CA=

# Clave para firmar los tokens de sesion (JWT): una frase larga y aleatoria. NO compartir.
JWT_SECRET=

# Origen permitido del frontend (CORS)
CORS_ORIGIN=http://localhost:5173
